# ─── MediaBot .env (محلی) / Railway Variables (سرور) ─────────────────────────

# ─── مدارک: https://my.telegram.org → API Development Tools ───
API_ID=your_api_id_here
API_HASH=your_api_hash_here

# توکن اصلی بات (از @BotFather). توکن‌های بیشتر از داخل وب‌پنل اضافه می‌شوند.
BOT_TOKEN=your_bot_token_here

#‌ شناسه عددی تلگرام ادمین اصلی (از @userinfobot)
ADMIN_ID=your_telegram_id_here

# اتصال دیتابیس — روی Railway: متغیر Reference بذار: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:password@host:port/dbname

# ─── وب‌پنل ───
PANEL_USERNAME=admin
PANEL_PASSWORD=your_strong_password_here
JWT_SECRET=random_long_string_here

# ─── تنظیمات دانلود (پیش‌فرض‌ها — قابل تغییر از پنل) ───
DEFAULT_MAX_FILE_SIZE_MB=500
DEFAULT_DAILY_LIMIT_MB=2048
DEFAULT_QUEUE_LIMIT=3
MAX_CONCURRENT_DOWNLOADS=2

# مسیر ذخیره موقت: روی Railway اپیفمرال /tmp رایگان؛ اگر volume داری بذار /data
TEMP_DIR=/tmp/mediabot